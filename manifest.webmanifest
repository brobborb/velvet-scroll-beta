{
  "name": "Velvet Scroll",
  "short_name": "Velvet Scroll",
  "description": "An ebook reader that scrolls for you, with a reading guide, read aloud and your books kept private on your device.",
  "id": "./",
  "start_url": "./?source=app",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone"
  ],
  "orientation": "any",
  "background_color": "#eef2f0",
  "theme_color": "#2c6a57",
  "categories": [
    "books",
    "education",
    "productivity"
  ],
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./?source=file",
      "accept": {
        "application/epub+zip": [
          ".epub",
          ".kepub"
        ],
        "application/pdf": [
          ".pdf"
        ],
        "application/x-mobipocket-ebook": [
          ".mobi",
          ".azw3",
          ".azw"
        ],
        "application/x-fictionbook+xml": [
          ".fb2"
        ],
        "application/vnd.comicbook+zip": [
          ".cbz"
        ],
        "text/plain": [
          ".txt"
        ]
      }
    }
  ],
  "screenshots": [
    {
      "src": "media/shot-library.webp",
      "sizes": "1280x800",
      "type": "image/webp",
      "form_factor": "wide",
      "label": "Your library"
    },
    {
      "src": "media/shot-reader.webp",
      "sizes": "1280x800",
      "type": "image/webp",
      "form_factor": "wide",
      "label": "Reading with the reading guide"
    }
  ]
}
